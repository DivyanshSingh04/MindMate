# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/mindmate
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/mindmate
MONGODB_URI=mongodb://127.0.0.1:27017/mindmate

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
